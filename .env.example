DATABASE_URL="postgresql://rental_user:rental_password@localhost:5432/rental_house?schema=public"

# Generate two independent random 32-byte values and encode each as standard
# base64. Never reuse these keys or commit real values.
PERSON_CITIZEN_ID_ENCRYPTION_KEY=""
PERSON_CITIZEN_ID_LOOKUP_HMAC_KEY=""

# Private uploads are stored outside the web root. Mount this directory as a
# persistent volume in container deployments.
PRIVATE_DATA_DIR="./private-data"

# Reserved for future object storage integration.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

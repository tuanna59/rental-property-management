generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceType {
  ROOM
  OWNER_HOME
  GARAGE
  ROOFTOP
  COMMON_AREA
  STORAGE
  OTHER
}

model Property {
  id           String    @id @default(cuid())
  name         String
  description  String?
  addressLine1 String?
  city         String?
  country      String?
  floors       Floor[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  @@index([archivedAt, createdAt])
}

model Floor {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  name       String
  level      Int?
  sortOrder  Int
  notes      String?
  spaces     Space[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([propertyId, archivedAt, sortOrder])
}

model Space {
  id         String    @id @default(cuid())
  floorId    String
  floor      Floor     @relation(fields: [floorId], references: [id], onDelete: Restrict)
  type       SpaceType
  name       String
  sortOrder  Int
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([floorId, archivedAt, sortOrder])
  @@index([type])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceType {
  ROOM
  OWNER_HOME
  GARAGE
  ROOFTOP
  COMMON_AREA
  STORAGE
  OTHER
}

enum TenancyOccupantRole {
  RESPONSIBLE
  ADDITIONAL
}

enum MeterType {
  ELECTRICITY
}

enum MeterReadingType {
  MONTHLY
  MOVE_IN
  MOVE_OUT
  METER_INSTALL
  METER_REMOVAL
  MANUAL
}

enum MeterReadingSource {
  MEASURED
  ESTIMATED
}

enum UtilityType {
  ELECTRICITY
  WATER
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
}

enum InvoiceType {
  REGULAR
  FINAL_SETTLEMENT
}

enum InvoiceLineType {
  RENT
  ELECTRICITY
  WATER
}

enum InvoiceAdjustmentType {
  CHARGE
  CREDIT
}

enum InvoiceMeterEvidenceRole {
  OPENING_ANCHOR
  CLOSING
  MANUAL_EVIDENCE
  MOVE_IN_BOUNDARY
  MOVE_OUT_BOUNDARY
  METER_INSTALL
  METER_REMOVAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum DepositTransactionType {
  RECEIPT
  REFUND
  DEDUCTION
  APPLIED_TO_INVOICE
}

enum DepositDeductionCategory {
  DAMAGE
  CLEANING
  OUTSTANDING_INVOICE
  OTHER
}

enum ExpenseCategory {
  REPAIR
  UTILITIES
  CLEANING
  SUPPLIES
  OTHER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskLinkedEntityType {
  PROPERTY
  SPACE
  MAINTENANCE
  INVOICE
}

enum TaskRecurrenceUnit {
  DAYS
  MONTHS
  YEARS
}

enum AssetStatus {
  ACTIVE
  RETIRED
  DISPOSED
}

enum AssetAttachmentType {
  PHOTO
  RECEIPT
  WARRANTY
  MANUAL
  SERIAL
  OTHER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Property {
  id                String             @id @default(cuid())
  name              String
  description       String?
  addressLine1      String?
  city              String?
  country           String?
  floors            Floor[]
  utilityRates      UtilityRate[]
  maintenanceIssues MaintenanceIssue[]
  expenses          Expense[]
  tasks             Task[]
  assetCategories   AssetCategory[]
  assets            Asset[]
  devices           Device[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?

  @@index([archivedAt, createdAt])
}

model Floor {
  id                String             @id @default(cuid())
  propertyId        String
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  name              String
  level             Int?
  sortOrder         Int
  notes             String?
  spaces            Space[]
  maintenanceIssues MaintenanceIssue[]
  expenses          Expense[]
  assets            Asset[]
  devices           Device[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?

  @@index([propertyId, archivedAt, sortOrder])
}

model Space {
  id                       String                    @id @default(cuid())
  floorId                  String
  floor                    Floor                     @relation(fields: [floorId], references: [id], onDelete: Restrict)
  type                     SpaceType
  name                     String
  sortOrder                Int
  notes                    String?
  tenancies                Tenancy[]
  meters                   Meter[]
  utilityRateOverrides     UtilityRateOverride[]
  maintenanceIssues        MaintenanceIssue[]
  expenses                 Expense[]
  assets                   Asset[]
  devices                  Device[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  archivedAt               DateTime?

  @@index([floorId, archivedAt, sortOrder])
  @@index([type])
}

model Person {
  id                  String            @id @default(cuid())
  fullName            String
  phone               String?
  phoneNormalized     String?
  dateOfBirth         DateTime?         @db.Date
  citizenIdEncrypted  String?
  citizenIdLookupHash String?           @unique
  citizenIdLast4      String?
  avatarStorageKey    String?
  citizenIdFrontKey   String?
  citizenIdBackKey    String?
  notes               String?
  tenancyOccupancies  TenancyOccupant[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archivedAt          DateTime?

  @@index([phoneNormalized])
  @@index([archivedAt, createdAt])
}

model Tenancy {
  id                  String                         @id @default(cuid())
  spaceId             String
  space               Space                          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  moveInDate          DateTime                       @db.Date
  moveOutDate         DateTime?                      @db.Date
  monthlyRentVnd      BigInt
  depositVnd          BigInt?
  moveInNotes         String?
  moveOutNotes        String?
  occupants           TenancyOccupant[]
  rentRates           TenancyRentRate[]
  responsibleHistory  TenancyResponsibleAssignment[]
  invoices            Invoice[]
  depositTransactions DepositTransaction[]
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@index([spaceId, moveInDate])
}

model TenancyRentRate {
  id             String   @id @default(cuid())
  tenancyId      String
  tenancy        Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  monthlyRentVnd BigInt
  effectiveFrom  DateTime @db.Date
  reason         String
  createdAt      DateTime @default(now())

  @@unique([tenancyId, effectiveFrom])
  @@index([tenancyId, effectiveFrom])
}

model Invoice {
  id                   String                 @id @default(cuid())
  tenancyId            String
  tenancy              Tenancy                @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  billingPeriod        DateTime               @db.Date
  invoiceDate          DateTime               @default(now()) @db.Date
  type                 InvoiceType            @default(REGULAR)
  serviceStart         DateTime?              @db.Date
  serviceEnd           DateTime?              @db.Date
  status               InvoiceStatus          @default(DRAFT)
  propertyNameSnapshot String
  roomNameSnapshot     String
  renterNameSnapshot   String
  finalizedAt          DateTime?
  lines                InvoiceLine[]
  adjustments          InvoiceAdjustment[]
  payments             Payment[]
  depositTransactions  DepositTransaction[]
  meterEvidence        InvoiceMeterEvidence[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([tenancyId, billingPeriod, type])
  @@index([billingPeriod, type, status])
}

model InvoiceMeterEvidence {
  id        String                    @id @default(cuid())
  invoiceId String
  invoice   Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  readingId String
  reading   MeterReading              @relation(fields: [readingId], references: [id], onDelete: Restrict)
  role      InvoiceMeterEvidenceRole?
  createdAt DateTime                  @default(now())

  @@unique([invoiceId, readingId])
  @@index([readingId])
}

model InvoiceLine {
  id                 String          @id @default(cuid())
  invoiceId          String
  invoice            Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  type               InvoiceLineType
  description        String
  sourceBillingMonth DateTime?       @db.Date
  servicePeriodStart DateTime?       @db.Date
  servicePeriodEnd   DateTime?       @db.Date
  calculatedAmount   Decimal         @db.Decimal(16, 3)
  finalAmount        Decimal         @db.Decimal(16, 0)
  isOverridden       Boolean         @default(false)
  overrideReason     String?
  metadata           Json
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([invoiceId, type])
}

model InvoiceAdjustment {
  id          String                @id @default(cuid())
  invoiceId   String
  invoice     Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  type        InvoiceAdjustmentType
  description String
  amount      Decimal               @db.Decimal(16, 0)
  reason      String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([invoiceId, createdAt])
}

model Payment {
  id                   String        @id @default(cuid())
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount               Decimal       @db.Decimal(16, 0)
  paymentDate          DateTime      @db.Date
  method               PaymentMethod
  reference            String?
  notes                String?
  isDepositApplication Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([invoiceId, paymentDate])
  @@index([paymentDate])
}

model DepositTransaction {
  id              String                    @id @default(cuid())
  tenancyId       String
  tenancy         Tenancy                   @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  type            DepositTransactionType
  amount          Decimal                   @db.Decimal(16, 0)
  transactionDate DateTime                  @db.Date
  category        DepositDeductionCategory?
  invoiceId       String?
  invoice         Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reference       String?
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([tenancyId, transactionDate])
  @@index([invoiceId])
}

model TenancyOccupant {
  id                     String                         @id @default(cuid())
  tenancyId              String
  tenancy                Tenancy                        @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  personId               String
  person                 Person                         @relation(fields: [personId], references: [id], onDelete: Restrict)
  responsibleAssignments TenancyResponsibleAssignment[]
  role                   TenancyOccupantRole
  startDate              DateTime                       @db.Date
  endDate                DateTime?                      @db.Date
  endedByTenancyMoveOut  Boolean                        @default(false)
  notes                  String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([tenancyId, startDate])
  @@index([personId, startDate])
}

model TenancyResponsibleAssignment {
  id            String          @id @default(cuid())
  tenancyId     String
  tenancy       Tenancy         @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  occupantId    String
  occupant      TenancyOccupant @relation(fields: [occupantId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime        @db.Date
  reason        String
  createdAt     DateTime        @default(now())

  @@unique([tenancyId, effectiveFrom])
  @@index([occupantId, effectiveFrom])
}

model Meter {
  id              String                @id @default(cuid())
  spaceId         String
  space           Space                 @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  type            MeterType             @default(ELECTRICITY)
  meterNumber     String?
  installedAt     DateTime              @db.Date
  removedAt       DateTime?             @db.Date
  notes           String?
  readings        MeterReading[]
  monthlyClosings MeterMonthlyClosing[]
  devices         Device[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([spaceId, type, installedAt])
}

model MeterReading {
  id              String                 @id @default(cuid())
  meterId         String
  meter           Meter                  @relation(fields: [meterId], references: [id], onDelete: Restrict)
  readingDate     DateTime               @db.Date
  billingMonth    DateTime?              @db.Date
  readingValue    Decimal                @db.Decimal(16, 3)
  readingType     MeterReadingType
  source          MeterReadingSource     @default(MEASURED)
  photoStorageKey String?
  notes           String?
  reason          String?
  monthlyClosings MeterMonthlyClosing[]
  evidencePhotos  MeterReadingPhoto[]
  invoiceEvidence InvoiceMeterEvidence[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([meterId, billingMonth])
  @@index([meterId, readingDate])
}

model MeterMonthlyClosing {
  id           String       @id @default(cuid())
  meterId      String
  meter        Meter        @relation(fields: [meterId], references: [id], onDelete: Restrict)
  readingId    String
  reading      MeterReading @relation(fields: [readingId], references: [id], onDelete: Restrict)
  billingMonth DateTime     @db.Date
  createdAt    DateTime     @default(now())

  @@unique([meterId, billingMonth])
  @@unique([readingId, billingMonth])
  @@index([readingId])
}

model MeterReadingPhoto {
  id         String       @id @default(cuid())
  readingId  String
  reading    MeterReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  storageKey String
  createdAt  DateTime     @default(now())

  @@index([readingId, createdAt])
}

model UtilityRate {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  utilityType   UtilityType
  rate          Decimal     @db.Decimal(16, 3)
  effectiveFrom DateTime    @db.Date
  effectiveTo   DateTime?   @db.Date
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([propertyId, utilityType, effectiveFrom])
}

model UtilityRateOverride {
  id            String      @id @default(cuid())
  spaceId       String
  space         Space       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  utilityType   UtilityType
  rate          Decimal     @db.Decimal(16, 3)
  effectiveFrom DateTime    @db.Date
  effectiveTo   DateTime?   @db.Date
  reason        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([spaceId, utilityType, effectiveFrom])
  @@index([spaceId, utilityType, effectiveFrom, effectiveTo])
}

model MaintenanceIssue {
  id          String              @id @default(cuid())
  propertyId  String
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  floorId     String?
  floor       Floor?              @relation(fields: [floorId], references: [id], onDelete: Restrict)
  spaceId     String?
  space       Space?              @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  assetId     String?
  asset       Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  title       String
  description String
  status      MaintenanceStatus   @default(OPEN)
  priority    MaintenancePriority @default(MEDIUM)
  reportedAt  DateTime            @db.Date
  reportedBy  String?
  assignedTo  String?
  notes       String?
  resolution  String?
  completedAt DateTime?           @db.Date
  expenses    Expense[]
  photos      MaintenancePhoto[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  archivedAt  DateTime?

  @@index([propertyId, status, priority])
  @@index([floorId, status])
  @@index([spaceId, status])
  @@index([assetId, status])
  @@index([reportedAt])
  @@index([archivedAt])
}

model MaintenancePhoto {
  id                 String           @id @default(cuid())
  maintenanceIssueId String
  maintenanceIssue   MaintenanceIssue @relation(fields: [maintenanceIssueId], references: [id], onDelete: Cascade)
  storageKey         String
  createdAt          DateTime         @default(now())

  @@index([maintenanceIssueId, createdAt])
}

model Expense {
  id                 String            @id @default(cuid())
  propertyId         String
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  floorId            String?
  floor              Floor?            @relation(fields: [floorId], references: [id], onDelete: Restrict)
  spaceId            String?
  space              Space?            @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  maintenanceIssueId String?
  maintenanceIssue   MaintenanceIssue? @relation(fields: [maintenanceIssueId], references: [id], onDelete: Restrict)
  assetId            String?
  asset              Asset?            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  expenseDate        DateTime           @db.Date
  category           ExpenseCategory
  description        String
  amount             Decimal            @db.Decimal(16, 0)
  receiptStorageKey  String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  archivedAt         DateTime?

  @@index([propertyId, expenseDate])
  @@index([floorId, expenseDate])
  @@index([spaceId, expenseDate])
  @@index([maintenanceIssueId])
  @@index([assetId, expenseDate])
  @@index([archivedAt])
}

model Task {
  id                   String                @id @default(cuid())
  propertyId           String
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  title                String
  description          String?
  status               TaskStatus            @default(TODO)
  priority             TaskPriority          @default(MEDIUM)
  dueDate              DateTime?              @db.Date
  linkedEntityType     TaskLinkedEntityType?
  linkedEntityId       String?
  recurrenceUnit       TaskRecurrenceUnit?
  recurrenceInterval   Int?
  completedAt          DateTime?
  previousOccurrenceId String?                @unique
  previousOccurrence   Task?                  @relation("TaskRecurrence", fields: [previousOccurrenceId], references: [id], onDelete: Restrict)
  nextOccurrence       Task?                  @relation("TaskRecurrence")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  archivedAt           DateTime?

  @@index([propertyId, status, dueDate])
  @@index([linkedEntityType, linkedEntityId])
  @@index([archivedAt])
}



model AssetCategory {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  name        String
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  @@unique([propertyId, name])
  @@index([propertyId, archivedAt, name])
}

model Asset {
  id                    String          @id @default(cuid())
  propertyId            String
  property              Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  floorId               String?
  floor                 Floor?          @relation(fields: [floorId], references: [id], onDelete: Restrict)
  spaceId               String?
  space                 Space?          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  categoryId            String
  category              AssetCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name                  String
  brand                 String?
  model                 String?
  serialNumber          String?
  purchaseDate          DateTime?        @db.Date
  purchasePrice         Decimal?         @db.Decimal(16, 0)
  warrantyExpiresAt     DateTime?        @db.Date
  notes                 String?
  status                AssetStatus      @default(ACTIVE)
  replacementForAssetId String?          @unique
  replacementForAsset   Asset?           @relation("AssetReplacement", fields: [replacementForAssetId], references: [id], onDelete: Restrict)
  replacedByAsset       Asset?           @relation("AssetReplacement")
  maintenanceIssues     MaintenanceIssue[]
  expenses              Expense[]
  attachments           AssetAttachment[]
  devices               Device[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  archivedAt            DateTime?

  @@index([propertyId, status])
  @@index([categoryId, status])
  @@index([floorId, status])
  @@index([spaceId, status])
  @@index([warrantyExpiresAt])
}

model AssetAttachment {
  id         String              @id @default(cuid())
  assetId    String
  asset      Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type       AssetAttachmentType
  title      String?
  storageKey String
  createdAt  DateTime            @default(now())

  @@index([assetId, type, createdAt])
}

model Device {
  id         String       @id @default(cuid())
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  floorId    String?
  floor      Floor?       @relation(fields: [floorId], references: [id], onDelete: Restrict)
  spaceId    String?
  space      Space?       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  assetId    String?
  asset      Asset?       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  meterId    String?
  meter      Meter?       @relation(fields: [meterId], references: [id], onDelete: Restrict)
  name       String
  deviceType String
  externalId String?
  protocol   String?
  status     DeviceStatus @default(UNKNOWN)
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  archivedAt DateTime?

  @@index([propertyId, status])
  @@index([spaceId, status])
  @@index([assetId])
  @@index([meterId])
  @@index([archivedAt])
}
